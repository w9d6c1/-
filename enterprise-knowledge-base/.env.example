# ========== 数据库 ==========
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=kb_user
MYSQL_PASSWORD=kb_pass_2024
MYSQL_DATABASE=knowledge_base

# ========== PostgreSQL (LangGraph Checkpoint) ==========
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pg_pass_2024
POSTGRES_DB=langgraph_checkpoint

# ========== Redis ==========
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== Elasticsearch ==========
ES_HOST=elasticsearch
ES_PORT=9200

# ========== Milvus ==========
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ========== MinIO ==========
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-docs

# ========== LLM ==========
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ========== Embedding ==========
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
# FAQ 专用轻量模型（512 维，独立于 Milvus）。留空则回退到 EMBEDDING_MODEL。
FAQ_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ========== Reranker ==========
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# ========== SiliconFlow (Embedding/Reranker 云端 API) ==========
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ========== 阿里云 SMS (手机验证码) ==========
# 留空则验证码直接显示在 API 返回中（开发/过渡用）
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ========== JWT ==========
JWT_SECRET_KEY=your-secret-key-here-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ========== App ==========
APP_NAME=企业知识库系统
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=DEBUG

# ========== CORS ==========
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ========== 部署 / 发布 / 监控 ==========
# 正式域名（deploy.sh 引用；未配置则用脚本内默认值）
DOMAIN=
# 发布配图的公开访问基址（Chrome 扩展拉取照片；未配置默认 https://localhost）
PUBLISH_PUBLIC_BASE_URL=
# Grafana 登录账号（生产环境务必改掉默认 admin/admin）
GRAFANA_USER=
GRAFANA_PASSWORD=

# ========== 通知 ==========
# 企微/钉钉 Webhook URL。留空则关闭通知。
WEBHOOK_URL=

# ========== 企业微信 (内部智能体渠道) ==========
# 企业 ID
WECOM_CORP_ID=
# 自建应用 AgentId
WECOM_AGENT_ID=
# 自建应用 Secret
WECOM_SECRET=
# 回调 Token
WECOM_TOKEN=
# 回调 EncodingAESKey（43 字符）
WECOM_AES_KEY=
# 企微用户默认角色（决定 scope 权限），默认 operator = public+internal
WECOM_DEFAULT_ROLE=operator
# 企微问答兜底拒绝语（检索不到内容时返回；留空用内置默认）
NO_ANSWER_REPLY=
# 腾讯云语音识别（企微语音消息转文字，一句话识别 SentenceRecognition）
# 需在腾讯云控制台开通「语音识别 - 一句话识别」服务
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
ASR_ENGINE_TYPE=16k_zh

# ========== 多源官方内容采集（阶段二）==========
# 微信公众号 — 素材管理 API（freepublish/batchget，拉取已群发图文）
# 申请：微信公众平台 → 设置与开发 → 基本配置
# WECHAT_MP_APPID=
# WECHAT_MP_APPSECRET=
WECHAT_MP_SOURCE_NAME=公司官方公众号

# 今日头条号 — 创作者开放平台图文/专栏
# TOUTIAO_ACCESS_TOKEN=
TOUTIAO_SOURCE_NAME=公司官方头条号

# 知乎企业号 — 数据开放平台用户内容 API（Bearer Access Secret + X-Request-Timestamp）
# Access Secret 在 developer.zhihu.com「个人中心」获取；不传 X-OAuth-Token 时拉本账号文章/回答
# ZHIHU_ACCESS_SECRET=
# 可选：全文公开页防爬兜底 Cookie
# ZHIHU_COOKIE=
# 是否抓取公开页全文（关闭=仅 API 摘要入库）
ZHIHU_FETCH_FULLTEXT=true
# 翻页/全文抓取间隔秒数（防爬）
ZHIHU_PAGE_DELAY=1.0
ZHIHU_SOURCE_NAME=公司官方知乎号

# B站专栏 — 创作中心专栏图文
# BILIBILI_ACCESS_TOKEN=
# BILIBILI_MID=
BILIBILI_SOURCE_NAME=公司官方B站专栏

# 企业官网 — CMS 接口 / 定向栏目采集
# OFFICIAL_WEBSITE_BASE_URL=
# OFFICIAL_WEBSITE_LIST_PATH=
OFFICIAL_WEBSITE_SOURCE_NAME=企业官网

# 采集调度（每日低峰，默认 02:00）
COLLECTOR_SYNC_HOUR=2
COLLECTOR_SYNC_MINUTE=0
COLLECTOR_DEFAULT_CATEGORY_ID=1
# HTTP 请求超时（秒）
COLLECTOR_REQUEST_TIMEOUT=20.0

# ========== 日志留存 ==========
# 对话日志保留天数（默认 180）。设为 0 则永久保留。
CHAT_LOG_RETENTION_DAYS=180

# ========== 前端 ==========
VITE_API_BASE_URL=http://localhost:8000
